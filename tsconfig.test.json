{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node",
      "vitest/globals",
      "vite/client"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "tests/**/*",
    "src/core/**/*",
    "src/shared/**/*",
    "src/main/**/*",
    "src/renderer/src/lib/**/*",
    "src/preload/api.d.ts",
    "src/renderer/src/**/*"
  ]
}