{
  "name": "craftshot",
  "productName": "Craftshot",
  "version": "1.0.0",
  "description": "Gestor de capturas de Minecraft con extracci\u00f3n autom\u00e1tica del F3, detecci\u00f3n de bioma y mobs.",
  "author": "Moises Guevara <mguevaraj27@gmail.com>",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && node scripts/check-preload.mjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:mod": "cd companion-mod && ./gradlew build -q && cp build/libs/craftshot-companion-1.0.0+26.3.jar ../resources/craftshot-companion.jar",
    "ocr": "tsx --tsconfig tsconfig.node.json scripts/ocr-cli.ts",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "build:labels": "tsx --tsconfig tsconfig.node.json scripts/build-clip-labels.ts",
    "eval:local": "tsx --tsconfig tsconfig.node.json scripts/eval-local-vision.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "fflate": "^0.8.3",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
